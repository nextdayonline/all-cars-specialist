{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/diensten",
      "destination": "/onderhoud",
      "permanent": false
    },
    {
      "source": "/airco-vullen-in-apeldoorn",
      "destination": "/airco",
      "permanent": true
    },
    {
      "source": "/aankoopkeuring",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/versnellingsbakolie-verversen",
      "destination": "/versnellingsbak-spoelen",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/apk.html",
      "destination": "/apk",
      "permanent": true
    },
    {
      "source": "/onderhoud.html",
      "destination": "/onderhoud",
      "permanent": true
    },
    {
      "source": "/specialistisch.html",
      "destination": "/specialistisch",
      "permanent": true
    },
    {
      "source": "/banden.html",
      "destination": "/banden",
      "permanent": true
    },
    {
      "source": "/airco.html",
      "destination": "/airco",
      "permanent": true
    },
    {
      "source": "/schadeherstel.html",
      "destination": "/schadeherstel",
      "permanent": true
    },
    {
      "source": "/over-ons.html",
      "destination": "/over-ons",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/privacyverklaring.html",
      "destination": "/privacyverklaring",
      "permanent": true
    },
    {
      "source": "/algemene-voorwaarden.html",
      "destination": "/algemene-voorwaarden",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|svg|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}